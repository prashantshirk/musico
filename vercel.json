{
  "framework": "vite",
  "routes": [
    {
      "src": "/api/navidrome/(.*)",
      "dest": "https://music.prashantshirke.me/$1"
    },
    {
      "src": "/api/ai-recommendations/(.*)",
      "dest": "http://104.211.94.130:8001/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "attribution-reporting=(), private-aggregation=(), private-state-token-issuance=(), private-state-token-redemption=(), join-ad-interest-group=(), run-ad-auction=(), browsing-topics=()"
        }
      ]
    }
  ],
  "outputDirectory": "dist"
}
